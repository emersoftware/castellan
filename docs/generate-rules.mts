import { readFileSync, writeFileSync } from "node:fs";
import { playerGuide, rules } from "../packages/shared/src/index.ts";

const path = new URL("./CURRENT-RULES.md", import.meta.url);
const content = `<!-- Generated by pnpm docs:rules. Do not edit; edit rules.ts / guide.ts. -->\n\n${playerGuide(rules, { chat: true }).trimEnd()}\n`;
if (process.argv.includes("--check")) {
  if (readFileSync(path, "utf8") !== content) throw new Error("CURRENT-RULES.md is stale. Run pnpm docs:rules.");
} else writeFileSync(path, content);
