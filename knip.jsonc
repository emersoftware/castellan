{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  // These workspaces form one application; a barrel export alone is not a consumer.
  "includeEntryExports": true,
  // Check individual exports even when a consumer imports a module namespace.
  "include": ["files", "dependencies", "unlisted", "binaries", "unresolved", "exports", "nsExports", "types", "nsTypes", "enumMembers", "namespaceMembers", "duplicates", "catalog", "catalogReferences"],
  "workspaces": {
    ".": {
      "entry": [
        "tools/elo.mts",
        "connectors/autonomous/{cli,validate,live-validate}.ts",
        "connectors/autonomous/test/**/*.test.ts",
        // Maintained art generators and diagnostics, invoked directly from Node.
        "assets/animations/package-units.mjs",
        "assets/animations/diagnostics/validate-atlases.mjs",
        "assets/wizard/render.mts",
        "assets/animations/wizard/prepare.mts",
        "assets/animations/wizard/preview.mts",
        // Directly invoked atlas crystal measurement and pulse review tool.
        "assets/animations/wizard/cast-points.mjs",
        "assets/animations/ranger/{idle,shoot,walk}-directions/package.mjs",
        "assets/icons/{export-hero-king,render-king-fire,render-king-icon}.mts"
      ],
      // Art tools invoke the system ffmpeg.
      "ignoreBinaries": ["ffmpeg"]
    },
    "packages/sandbox": {
      "entry": ["src/index.{ts,js}", "test/**/*.test.ts"]
    },
    "packages/shared": {
      "entry": ["src/index.{ts,js}"]
    },
    "connectors/open-arena": {
      "entry": ["src/{cli,seed,server,auditor,egress,agent,fixture}.mjs", "test/**/*.test.ts"],
      // util-linux in the arena image drops privileges before starting a harness.
      "ignoreBinaries": ["setpriv"]
    },
    "connectors/loop-keepers": {
      // Shell launchers, harness tool modules and credential/setup commands.
      "entry": [
        "{antigravity,codex,cursor,deepseek,jev,minimax,opencode}/agent.mjs",
        "antigravity/{play,preflight,tool}.mjs",
        "claude-code/{first-turn,stop-hook}.mjs",
        "deepseek/{game-tools,key,setup}.mjs",
        "minimax/{key,setup}.mjs",
        "test/**/*.test.ts"
      ]
    },
    "connectors/mcp": {
      "entry": ["src/tools.{ts,js}"]
    },
    "connectors/cli": {
      "entry": ["src/index.{ts,js}", "test/**/*.test.ts"]
    },
    "connectors/castellan-bot": {
      "entry": ["test/**/*.test.ts"]
    },
    "packages/engine": {
      "entry": ["src/index.{ts,js}", "test/**/*.test.ts", "scripts/{benchmark-replay,verify-replays}.ts"]
    },
    "packages/server": {
      "entry": ["src/app.{ts,js}", "test/**/*.test.ts", "src/{castle-animation-demo,sound-demos}.ts"]
    },
    "packages/sim": {
      "entry": ["src/index.{ts,js}",
        "test/**/*.test.ts",
        "src/{balance-optimize,battles-baseline,bot-smoke,choice-probe,extract-recent,script-sets,synthetic-matrix}.mts"
      ]
    },
    "packages/web": {
      "entry": [
        "test/**/*.test.ts",
        "scripts/{archer-animations,assets,building-animations,building-collapse,castle-damage,door-sprites,templates,unit-animations}.mjs",
        "scripts/{check-building-collapse,check-castle-damage,check-doors,check-landing-audio,check-worker-idle,record,sfx,shot}.mjs",
        "scripts/favicon.mts"
      ],
      "ignoreBinaries": ["ffmpeg", "ffprobe"],
      // The DevDay deck is a prebuilt static site with its own bundled scripts.
      "ignore": ["public/devday/**"]
    }
  }
}
