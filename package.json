{
  "name": "castellan",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:rules": "tsx docs/generate-rules.mts",
    "docs:check": "tsx docs/generate-rules.mts --check",
    "test": "pnpm docs:check && vitest run",
    "test:engine": "pnpm test --project engine --project sandbox --project sim",
    "test:integration": "pnpm test --project server --project connectors --project catalog",
    "test:agents": "pnpm test --project agents",
    "test:web": "pnpm test --project web",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.scripts.json && pnpm --filter video typecheck",
    "design:audit": "tsx tools/design-audit/index.ts",
    "server": "pnpm --filter @castellan/server start",
    "web": "pnpm --filter @castellan/web dev",
    "sim": "pnpm --filter @castellan/sim sim",
    "castellan": "castellan",
    "aoa": "castellan",
    "seed-replays": "pnpm --filter @castellan/server seed-replays",
    "build": "pnpm --filter @castellan/web build",
    "build:cloudflare": "pnpm --filter @castellan/web build --mode cloudflare",
    "cloud:types": "wrangler types cloudflare/worker-configuration.d.ts",
    "cloud:typecheck": "pnpm cloud:types && tsc -p cloudflare/tsconfig.json && tsc -p cloudflare/tsconfig.tools.json",
    "cloud:dev": "pnpm build:cloudflare && wrangler dev",
    "cloud:migrate": "wrangler d1 migrations apply DB --remote",
    "publish:replays": "tsx cloudflare/publish.ts",
    "cloud:verify": "tsx cloudflare/verify.ts",
    "cloud:deploy": "pnpm build:cloudflare && pnpm cloud:typecheck && wrangler deploy",
    "castellan-bot": "pnpm --filter @castellan/castellan-bot play"
  },
  "devDependencies": {
    "@castellan/cli": "workspace:*",
    "@castellan/mcp": "workspace:*",
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^24.0.0",
    "jsdom": "^30.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.145.0"
  },
  "packageManager": "pnpm@10.20.0"
}
