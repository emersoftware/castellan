#!/bin/sh
# Fast checks before each commit; `pnpm test` and `pnpm typecheck` remain the full gate.
# Knip and jscpd read the whole working tree; ESLint reads only the staged files. Skip once with --no-verify.
set -e
pnpm -s check:unused
pnpm -s check:copies
files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.js' '*.mjs' '*.ts' '*.tsx' '*.mts')
[ -z "$files" ] || pnpm -s exec eslint --cache --cache-location node_modules/.cache/eslint/ --no-warn-ignored $files
